// IceMelt 命令行前端的版本资源（模板）。
//
// 由 xmake 的 add_configfiles 生成到 $(builddir)/version-cli.rc，再编译进 icemelt.exe。
// 变量名是 xmake 内置的，来自 xmake.lua 的 set_version()：
//   @VERSION@ / @VERSION_MAJOR@ / @VERSION_MINOR@ / @VERSION_ALTER@
// 注意第三段叫 ALTER（不是 PATCH），也没有 VERSION_STRING 这个变量 —— 写错会硬报错；
// 注释里出现 "@名字@" 也会被当成变量替换，所以这里刻意不带 @ 号。
//
// 版本号必须是三段纯数字（v 前缀只出现在发布包名里，不进资源）：CI 用 tag 覆盖
// 版本时会先把它剥成 1.2.3 再传 --app_version。

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_ALTER@,0
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_ALTER@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IceMelt"
            VALUE "FileDescription", "IceMelt command line front end"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "icemelt"
            VALUE "OriginalFilename", "icemelt.exe"
            VALUE "ProductName", "IceMelt"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
