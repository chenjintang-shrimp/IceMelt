// IceMelt 图形前端的版本资源（模板）。
//
// 由 xmake 的 add_configfiles 生成到 $(builddir)/version-gui.rc，与 src/gui 里的
// manifest rc 一起编译进 icemelt-gui.exe（两个 .rc 各管一件事：这里管版本，那边管提权）。
// 变量含义与 resource/version-cli.rc.in 相同，见那边的注释。

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_ALTER@,0
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_ALTER@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IceMelt"
            VALUE "FileDescription", "IceMelt graphical front end"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "icemelt-gui"
            VALUE "OriginalFilename", "icemelt-gui.exe"
            VALUE "ProductName", "IceMelt"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
