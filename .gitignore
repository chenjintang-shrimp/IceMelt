# ---- xmake ----
.xmake/
build/
*.xmake

# ---- MSVC / VS ----
.vs/
x64/
Debug/
Release/
*.pdb
*.ilk
*.exp
*.lib
*.obj

# ---- ntfs-3g (autotools + cygwin) 构建产物 ----
# 保留 autotools 输入（configure / config.h.in / Makefile.in / configure.ac / m4 等），
# 忽略其输出。config.h 不入库：它由 configure 生成，缺失时 xmake 会自动补上
# （见 xmake.lua 的 ntfs3g.config 规则）。
third_party/ntfs-3g/config.h

# 其余 configure 生成物（由同名 .in 模板产出）。本工程不消费它们，且其中一个
# 会把构建机的绝对路径写进 prefix，故一律不入库。
third_party/ntfs-3g/**/*.8
third_party/ntfs-3g/**/*.pc
third_party/ntfs-3g/**/*.script.so
third_party/ntfs-3g/libtool
third_party/ntfs-3g/config.log
third_party/ntfs-3g/config.status
third_party/ntfs-3g/stamp-h1
third_party/ntfs-3g/Makefile
third_party/ntfs-3g/**/Makefile
third_party/ntfs-3g/.libs/
third_party/ntfs-3g/.deps/
third_party/ntfs-3g/**/.libs/
third_party/ntfs-3g/**/.deps/
*.o
*.lo
*.la
*.so
*.a
*.dll
*.exe

# ---- 杂项 ----
__pycache__/
*.swp
.idea/
.clangd/
compile_commands.json
